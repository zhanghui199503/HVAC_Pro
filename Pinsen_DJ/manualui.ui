      <property name="styleSheet">
       <string notr="true">/*border-radius:10px;
background-color: rgb(140, 194, 105);*/

QPushButton
{
	background-color:  rgb(0, 150, 0);/*背景色*/ 
	border-style: outset;
	border-width: 2px;
	border-radius:24px; /*边界圆滑*/
	border-color: #8B7355;
	font: bold 24px;
	min-width:2em;
	color:white; /*字体颜色*/
	font-family:微软雅黑;
	padding: 5px;
}
 
/*QPushButton:hover
{
	background-color: rgb(0, 150, 0);
}*/
 
QPushButton:pressed
{
	background-color: #1E90FF; /*伪状态经过时背景色*/ 
	border-style: inset;
}
QPushButton::!enabled{
	background-color: rgb(100, 100, 100);
	border-style: inset;
}
</string>
