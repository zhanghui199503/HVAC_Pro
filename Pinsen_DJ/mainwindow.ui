	border-width: 2px;
	border-radius:15px; /*边界圆滑*/
	border-color: #8B7355;
	font: bold 18px;
	min-width:2em;
	color:black; /*字体颜色*/
	font-family:微软雅黑;

}
QPushButton:hover {

        border: 2px solid #2575FC;
    }
 
QPushButton:pressed
{
	background-color: #1E90FF; /*伪状态经过时背景色*/ 
	border-style: inset;
}
QPushButton::!enabled{
	background-color: rgb(100, 100, 100);
	border-style: inset;
}
