     <property name="styleSheet">
      <string notr="true">
QGroupBox {
    background-color: none; /* 背景颜色 */
    border: 2px solid black; /* 边框颜色 */
    border-radius: 8px; /* 圆角边框 */
    margin-top: 16px; /* 上边距 */
    padding-top: 16px; /* 内边距 */
    font-family: &quot;Segoe UI&quot;;
    font-size: 24px;
    font-weight: bold;
    color: #4CAF50; /* 标题颜色 */
}

/* 设置 GroupBox 标题样式 */
QGroupBox::title {
    subcontrol-origin: margin; /* 标题位置 */
    subcontrol-position: top; /* 标题对齐方式 */
    padding: 0 4px; /* 标题内边距 */
    background-color: black; /* 标题背景颜色 */
    color: white; /* 标题文字颜色 */
    border-radius: 4px; /* 标题圆角 */
    font-size: 18px;
}
</string>
